# Groq API Key (optional — prefer adding keys via Admin UI)
# If set, will be auto-seeded into the database on first startup
GROQ_API_KEY=

# Google API Key (for Gemini embeddings in semantic cache)
GOOGLE_API_KEY=

# Anthropic API Key (optional — enables the "anthropic" provider)
ANTHROPIC_API_KEY=

# Provider used when a request omits "provider" (groq | google | anthropic)
SWITCHBOARD_PROVIDER=groq

# Redis Cache
# Under docker compose this is overridden to redis://:${REDIS_PASSWORD}@redis:6379/0.
# Running Redis yourself? Include the password in the URL the same way.
REDIS_URL=redis://localhost:6379/0

# Redis password. docker compose refuses to start without it.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=

# Grafana admin password (user: admin). docker compose refuses to start
# without it. Anonymous dashboard access is off, so this is the only way in.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GRAFANA_ADMIN_PASSWORD=

# Gateway Config (inside the container)
PORT=8000
HOST=0.0.0.0

# Host ports published by docker compose. setup.sh remaps these automatically
# if something else on your machine already holds one.
# Redis is intentionally not published to the host, so it has no port here.
GATEWAY_PORT=8000
ADMIN_UI_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# SQLite database path (relative to project root)
SQLITE_DB_PATH=data/switchboard.db

# Fernet encryption key for API keys at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Gateway authentication ───────────────────────────────────────────────────
# REQUIRED. The gateway refuses to start if either is empty — an unset token
# must never quietly mean "no authentication".
#
# Generate each with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Both accept a comma-separated list, so a token can be rotated without
# downtime: add the new one, migrate callers, then remove the old.
#
#   ADMIN_TOKENS   guards /admin/* and /openapi.json. Also works on /v1/*
#                  (superset), which is what lets the dashboard hold one token.
#   CLIENT_TOKENS  guards /v1/* only. Hand these to API callers — a client
#                  token cannot read or modify your provider keys.
#
# ./setup.sh generates both on first run and never rotates them afterwards.
ADMIN_TOKENS=
CLIENT_TOKENS=
